{
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://priya-textiles.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://priya-textiles.onrender.com/socket.io/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://priya-textiles.onrender.com/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://priya-textiles.onrender.com/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}